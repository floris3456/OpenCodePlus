+  readonly stop: AbortController
+  last?: UsageView
+}
+
+const feeds = new Map<string, Feed>()
+
+/** The usage watch for one CPA and key, shared by every plugin instance in this process (OpenCode sets a
+ * plugin up once per location): one held request instead of one per open folder. A later subscriber gets
+ * the latest view at once. Returns the unsubscribe; the last one stops the watch. */
+export function shareUsage(fetchFn: Fetch, conn: Connection, onView: (view: UsageView) => void, timing?: WatchTiming): () => void {
+  const id = JSON.stringify([originOf(conn.baseURL), conn.key])
+  const feed = feeds.get(id) ?? startFeed(id, fetchFn, conn, timing)
+  feed.listeners.add(onView)
+  if (feed.last) onView(feed.last)
+  return () => {
+    if (!feed.listeners.delete(onView) || feed.listeners.size > 0) return
+    feed.stop.abort()
+    if (feeds.get(id) === feed) feeds.delete(id)
+  }
+}
+
+function startFeed(id: string, fetchFn: Fetch, conn: Connection, timing: WatchTiming | undefined): Feed {
+  const feed: Feed = { listeners: new Set(), stop: new AbortController() }
+  feeds.set(id, feed)
+  void watchUsage(fetchFn, conn, (view) => {
+    feed.last = view
+    for (const listener of feed.listeners) listener(view)
+  }, feed.stop.signal, timing)
+  return feed
+}
