#!/bin/sh
set -e

# Capture the caller's working directory before any path resolution or cd.
CALLER_DIR="${PWD:-$(pwd)}"

# Resolve the real path of this script, following symlinks.
TARGET="$0"
case "$TARGET" in
  */*) ;;
  *)
    TARGET=$(command -v "$TARGET" 2>/dev/null || echo "./$TARGET")
    ;;
esac

RESOLVED=""
if command -v readlink >/dev/null 2>&1; then
  RESOLVED=$(readlink -f "$TARGET" 2>/dev/null || true)
fi

if [ -n "$RESOLVED" ] && [ -e "$RESOLVED" ]; then
  TARGET="$RESOLVED"
else
  while [ -L "$TARGET" ]; do
    DIR=$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)
    LINK=$(readlink "$TARGET")
    case "$LINK" in
      /*) TARGET="$LINK" ;;
      *) TARGET="$DIR/$LINK" ;;
    esac
  done
fi

SCRIPT_DIR=$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)
REPO=$(cd -P "$SCRIPT_DIR/../../.." >/dev/null 2>&1 && pwd)

if ! command -v bun >/dev/null 2>&1; then
  echo "opencodeplus: 'bun' was not found on PATH. Please install Bun to use opencodeplus." >&2
  exit 1
fi

if [ ! -f "$REPO/packages/cli/src/index.ts" ]; then
  echo "opencodeplus: CLI entrypoint not found at $REPO/packages/cli/src/index.ts (script must be run from or symlinked to the repository)" >&2
  exit 1
fi

PRELOAD="$SCRIPT_DIR/restore-cwd.ts"
if [ ! -f "$PRELOAD" ]; then
  echo "opencodeplus: Preload script not found at $PRELOAD" >&2
  exit 1
fi

# Use the 'plus' storage channel unless overridden by caller, keeping client-local
# state (like tabs) isolated from installed opencode2.
export OPENCODE_TUI_CHANNEL="${OPENCODE_TUI_CHANNEL:-plus}"

# Plus is gated on project configuration; if OPENCODE_CONFIG_PROJECT_DISABLE is set,
# the Instructions screen silently has nothing to work with.
unset OPENCODE_CONFIG_PROJECT_DISABLE

# --cwd "$REPO/packages/cli" is strictly required because running bun directly
# against the CLI entrypoint from another directory fails JSX runtime resolution
# ('react/jsx-dev-runtime'). However, --cwd changes process.cwd() for the child,
# which causes cwd-sensitive subcommands (such as 'mcp add' or 'mcp list') to target
# the fork's packages/cli directory instead of the user's project.
#
# To prevent silent misdirection:
# 1. Refuse any invocation naming a subcommand; subcommands must be run from
#    the repository via 'bun run dev <subcommand>'.
#    Because CLI usage is 'opencode <subcommand> [flags] [<directory>]', a subcommand
#    can only ever appear as $1. Inspecting only $1 prevents flag values (such as
#    '--model anthropic/x' or '--prompt "fix bug"') from being misidentified as subcommands.
# 2. For the default TUI invocation, pass the caller's directory explicitly
#    as the directory argument unless the user already supplied one as the last argument.
# 3. Restore the target directory before the CLI entrypoint executes via a Bun
#    --preload module (restore-cwd.ts) using OPENCODEPLUS_CALLER_CWD, so the CLI
#    and Plus plugin bind to the caller project rather than the fork.
#
# Residual ambiguity: if a value-taking flag's value happens to name an existing
# directory AND is the last argument (for example '--prompt src' run where 'src/'
# exists), it is indistinguishable from a directory positional in POSIX sh without
# encoding flag arity, so it is treated as the directory. Note that encoding
# upstream flag arity was deliberately avoided because it would silently drift
# from upstream. Do not add complexity to chase this case.

if [ "$#" -gt 0 ]; then
  case "$1" in
    -*)
      ;;
    *)
      if [ ! -d "$1" ]; then
        echo "opencodeplus: '$1' is not a directory. opencodeplus runs the Instructions TUI only; cwd-sensitive subcommands such as 'mcp add' would write to the wrong project. Run subcommands from the repository with 'bun run dev <subcommand>'." >&2
        exit 1
      fi
      ;;
  esac
fi

has_dir=0
if [ "$#" -gt 0 ]; then
  for last_arg in "$@"; do :; done
  case "$last_arg" in
    -*)
      ;;
    *)
      if [ -d "$last_arg" ]; then
        has_dir=1
      fi
      ;;
  esac
fi

if [ "$has_dir" -eq 1 ]; then
  case "$last_arg" in
    /*)
      TARGET_DIR="$last_arg"
      ;;
    *)
      abs_dir=$(cd "$last_arg" 2>/dev/null && pwd || true)
      if [ -n "$abs_dir" ]; then
        TARGET_DIR="$abs_dir"
        i=1
        while [ "$i" -lt "$#" ]; do
          set -- "$@" "$1"
          shift
          i=$((i + 1))
        done
        set -- "$@" "$TARGET_DIR"
        shift
      else
        TARGET_DIR="$last_arg"
      fi
      ;;
  esac
else
  TARGET_DIR="$CALLER_DIR"
fi

export OPENCODEPLUS_CALLER_CWD="$TARGET_DIR"

if [ "$has_dir" -eq 1 ]; then
  exec bun --preload "$PRELOAD" --cwd "$REPO/packages/cli" "$REPO/packages/cli/src/index.ts" "$@"
else
  exec bun --preload "$PRELOAD" --cwd "$REPO/packages/cli" "$REPO/packages/cli/src/index.ts" "$@" "$TARGET_DIR"
fi
